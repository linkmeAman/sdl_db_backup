DB_USER=backup_logical
DB_PASS=change-me
# Database connection details. DB_ENGINE supports 'mysql' or 'postgres'.
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
BACKUP_DIR=./backups
BACKUP_LOG_DIR=./backups/logs
BACKUP_SYSTEMD_SERVICE_NAME=sdl-db-backup.service
BACKUP_SYSTEMD_TIMER_NAME=sdl-db-backup.timer
# Optional 32-byte key to enable AES-256-CFB stream encryption for logical .sql.gz files
BACKUP_ENCRYPTION_KEY=
MYSQL_BIN=mysql
MYSQLDUMP_BIN=mysqldump

BACKUP_RETRY_COUNT=3
BACKUP_RETRY_BASE_DELAY=2s
BACKUP_RETRY_MAX_DELAY=20s
BACKUP_DISCOVERY_TIMEOUT=30s
BACKUP_PREFLIGHT_TIMEOUT=15s
# Number of backups to keep (Grandfather-Father-Son rotation)
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BACKUP_CLEANUP_FAIL_FATAL=false

# Logical backup settings.
# DB_USER / DB_PASS are used for mysql and mysqldump logical backups.
# Use a dedicated backup-only MySQL user, not an app/phpMyAdmin editor account.
# Recommended grants for each application database:
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON `db_name`.* TO 'backup_logical'@'localhost';
# Required global routine metadata grant for full routine dumps on MySQL 8.0+:
#   GRANT SHOW_ROUTINE ON *.* TO 'backup_logical'@'localhost';
# SHOW DATABASES will list only the databases granted to this user.
# Logical backup controls.
BACKUP_LOGICAL_ENABLED=true
BACKUP_LOGICAL_SCHEDULE=daily@00:00,06:00,12:55,18:00
# Empty means all granted non-system databases.
BACKUP_LOGICAL_DATABASES=
# Empty means all tables. Format: db1:table_a,table_b;db2:table_c
BACKUP_LOGICAL_TABLES=
BACKUP_LOGICAL_TIMEOUT_PER_DB=30m
BACKUP_LOGICAL_S3_UPLOAD_ENABLED=true

# Physical backup settings.
# BACKUP_XTRABACKUP_USER / BACKUP_XTRABACKUP_PASS are the MySQL user credentials
# used only by xtrabackup. This can be different from DB_USER.
# BACKUP_XTRABACKUP_RUN_AS_USER is the Linux user used to execute xtrabackup,
# usually mysql so it can read protected MySQL data files.
# Required MySQL grants for BACKUP_XTRABACKUP_USER:
#   GRANT BACKUP_ADMIN, PROCESS, RELOAD, LOCK TABLES, REPLICATION CLIENT ON *.* TO 'xtrabackup'@'localhost';
#   GRANT SELECT ON performance_schema.replication_group_members TO 'xtrabackup'@'localhost';
#   GRANT SELECT ON performance_schema.keyring_component_status TO 'xtrabackup'@'localhost';
#   FLUSH PRIVILEGES;
BACKUP_PHYSICAL_ENABLED=true
BACKUP_PHYSICAL_SCHEDULE=weekly@sun,02:00
BACKUP_PHYSICAL_TIMEOUT=6h
BACKUP_PHYSICAL_S3_UPLOAD_ENABLED=true
BACKUP_XTRABACKUP_BIN=xtrabackup
BACKUP_XTRABACKUP_PARALLEL=4
BACKUP_XTRABACKUP_USER=xtrabackup
BACKUP_XTRABACKUP_PASS=change-me
BACKUP_XTRABACKUP_SOCKET=/var/run/mysqld/mysqld.sock
BACKUP_XTRABACKUP_RUN_AS_USER=mysql
BACKUP_XTRABACKUP_WORK_DIR=/tmp

# Shared S3 settings.
BACKUP_S3_BUCKET=change-me
BACKUP_S3_REGION=change-me
BACKUP_S3_LOGICAL_PREFIX=logical
BACKUP_S3_PHYSICAL_PREFIX=backup-as-it-is
BACKUP_S3_KEY_ID=change-me
BACKUP_S3_KEY_SECRET=change-me

# Logical backup S3 upload settings.
BACKUP_S3_UPLOAD_MODE=direct
BACKUP_S3_UPLOAD_URL=
BACKUP_S3_UPLOAD_TIMEOUT=2h
BACKUP_S3_PHP_BIN=/usr/bin/php
BACKUP_S3_UPLOAD_SCRIPT=

# Built-in API server settings.
BACKUP_API_ENABLED=false
BACKUP_API_LISTEN_ADDR=127.0.0.1:8086
BACKUP_API_BASE_PATH=/api/v1
BACKUP_API_AUTH_ENABLED=false
BACKUP_API_BEARER_TOKEN=

# Optional runtime label written into run metadata.
BACKUP_EXECUTION_SOURCE=runner

# Prometheus label customisation.
# These control the label set applied to every metric in the .prom file.
# BACKUP_METRICS_JOB     - Prometheus job label (default: sdl_db_backup)
# BACKUP_METRICS_SERVICE - Prometheus service label (default: mysql)
# BACKUP_METRICS_ENV     - Prometheus env label (optional; omitted from metric if empty)
# BACKUP_METRICS_REGION  - Prometheus region label (optional; omitted from metric if empty)
BACKUP_METRICS_JOB=sdl_db_backup
BACKUP_METRICS_SERVICE=mysql
BACKUP_METRICS_ENV=
BACKUP_METRICS_REGION=

# --- RESTORE VALIDATION (SANDBOX TESTING) ---
# Set up a dedicated, isolated sandbox database to safely test restore operations.
# WARNING: NEVER point this to a live/production database. The validation process
# will drop and recreate tables during testing.
RESTORE_TEST_ENABLED=false
RESTORE_TEST_HOST=
RESTORE_TEST_PORT=3306
RESTORE_TEST_USER=root
RESTORE_TEST_PASS=

# Schedule formats:
#   always
#   disabled
#   daily@07:30
#   weekly@sun,07:30
#   interval@24h
