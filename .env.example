DB_USER=backup_user
DB_PASS=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
BACKUP_DIR=/srv/backup/mysql_backup

# Optional durable log location. Defaults to BACKUP_DIR/logs when empty.
BACKUP_LOG_DIR=/srv/backup/mysql_backup/logs

# Optional overrides when mysql or mysqldump are not on PATH.
MYSQL_BIN=mysql
MYSQLDUMP_BIN=mysqldump

# Retry and timeout tuning.
BACKUP_RETRY_COUNT=3
BACKUP_RETRY_BASE_DELAY=2s
BACKUP_RETRY_MAX_DELAY=20s
BACKUP_TIMEOUT_PER_DB=30m
BACKUP_DISCOVERY_TIMEOUT=30s
BACKUP_PREFLIGHT_TIMEOUT=15s

# Retention and failure behavior.
BACKUP_RETENTION_DAYS=5
BACKUP_CLEANUP_FAIL_FATAL=false

# S3 upload after backup. Set to your upload-route.php endpoint to enable.
# e.g. https://backup-admin.example.com/routes/upload-route.php
BACKUP_S3_UPLOAD_URL=
BACKUP_S3_UPLOAD_TIMEOUT=2h
BACKUP_CLEANUP_FAIL_FATAL=false