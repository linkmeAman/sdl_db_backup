DB_USER=backup_logical
DB_PASS=change-me
# Database connection details. DB_ENGINE supports 'mysql' or 'postgres'.
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
BACKUP_DIR=./backups
# Optional; defaults to BACKUP_DIR/logs. The lock defaults to this directory/backup.lock.
BACKUP_LOG_DIR=
# Collector timestamp parser override; empty uses the host timezone used by the runner.
BACKUP_LOG_TIMEZONE=
BACKUP_SYSTEMD_SERVICE_NAME=sdl-db-backup.service
BACKUP_SYSTEMD_TIMER_NAME=sdl-db-backup.timer
# Set to true to allow scheduled runner tasks to execute as root user
BACKUP_ALLOW_ROOT_RUNNER=false
# Optional 32-byte raw key or 64-character hexadecimal key to enable
# authenticated AES-256-GCM stream encryption for logical .sql.gz files.
BACKUP_ENCRYPTION_KEY=
MYSQL_BIN=mysql
MYSQLDUMP_BIN=mysqldump

BACKUP_RETRY_COUNT=3
BACKUP_RETRY_BASE_DELAY=2s
BACKUP_RETRY_MAX_DELAY=20s
BACKUP_DISCOVERY_TIMEOUT=30s
BACKUP_PREFLIGHT_TIMEOUT=15s
# GFS selection counts among verified complete captures. Deletion is held
# by default; authorized cleanup quarantines rather than automatically purges.
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
# Preserve this many newest locally sandbox-restore-verified runs even if they
# would otherwise fall outside GFS retention. Set 0 only deliberately.
BACKUP_RETENTION_MIN_VERIFIED=1
BACKUP_CLEANUP_FAIL_FATAL=false
# By default, a full backup fails if a view or other object would be skipped.
# Enable only when an explicitly partial backup is acceptable.
BACKUP_ALLOW_OBJECT_OMISSIONS=false

# Logical backup settings.
# DB_USER / DB_PASS are used for mysql and mysqldump logical backups.
# Use a dedicated backup-only MySQL user, not an app/phpMyAdmin editor account.
# Recommended grants for each application database:
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT ON `db_name`.* TO 'backup_logical'@'localhost';
# Required global routine metadata grant for full routine dumps on MySQL 8.0+:
#   GRANT SHOW_ROUTINE ON *.* TO 'backup_logical'@'localhost';
# SHOW DATABASES will list only the databases granted to this user.
# Logical backup controls.
BACKUP_LOGICAL_ENABLED=true
BACKUP_LOGICAL_SCHEDULE=daily@00:00,06:00,12:55,18:00
# Empty means all granted non-system databases.
BACKUP_LOGICAL_DATABASES=
# Empty means all tables. Format: db1:table_a,table_b;db2:table_c
BACKUP_LOGICAL_TABLES=
BACKUP_LOGICAL_TIMEOUT_PER_DB=30m
# Optional stronger restore-validation support. When true, the backup captures
# exact per-table and per-database total row counts using COUNT(*) across every
# base table. This is slower on large databases but allows sandbox restore
# tests to verify exact restored row totals beyond schema-only fidelity.
BACKUP_EXACT_ROW_COUNTS=false
# Optional bounded content verification. When true, the backup captures a
# deterministic SHA-256 over the first N rows of each base table that has a
# primary key, ordered by that key. Sandbox restore validation compares the
# same sampled rows after restore.
BACKUP_SAMPLE_DATA_CHECKS=false
BACKUP_SAMPLE_DATA_ROWS=50
# Concurrent logical dumps across databases. Keep this modest to avoid DB overload.
BACKUP_LOGICAL_PARALLEL=2
# gzip level for logical dump artifacts. 1 is fastest, 9 is smallest, 0 disables compression.
BACKUP_LOGICAL_GZIP_LEVEL=1
# Optional MySQL point-in-time-recovery (PITR) manifest metadata. When enabled,
# each MySQL dump embeds a commented --source-data binlog coordinate and the
# run manifest records the observed server GTID/binlog state. This commonly
# requires REPLICATION CLIENT plus the privileges mysqldump needs for
# --source-data (often RELOAD or FLUSH_TABLES). Keep REQUIRED=false until the
# grants and independent binlog archive have been tested in a restore drill.
BACKUP_MYSQL_PITR_METADATA_ENABLED=false
BACKUP_MYSQL_PITR_METADATA_REQUIRED=false
BACKUP_LOGICAL_S3_UPLOAD_ENABLED=false
# Direct S3 uploads write and verify COMPLETED.json last. Keep this enabled for
# recovery-grade backups. Legacy PHP/HTTP upload modes require setting false.
BACKUP_REQUIRE_REMOTE_COMPLETION=true

# Physical backup settings.
# BACKUP_XTRABACKUP_USER / BACKUP_XTRABACKUP_PASS are the MySQL user credentials
# used only by xtrabackup. This can be different from DB_USER.
# BACKUP_XTRABACKUP_RUN_AS_USER is the Linux user used to execute xtrabackup,
# usually mysql so it can read protected MySQL data files.
# Required MySQL grants for BACKUP_XTRABACKUP_USER:
#   GRANT BACKUP_ADMIN, PROCESS, RELOAD, LOCK TABLES, REPLICATION CLIENT ON *.* TO 'xtrabackup'@'localhost';
#   GRANT SELECT ON performance_schema.replication_group_members TO 'xtrabackup'@'localhost';
#   GRANT SELECT ON performance_schema.keyring_component_status TO 'xtrabackup'@'localhost';
#   FLUSH PRIVILEGES;
BACKUP_PHYSICAL_ENABLED=false
BACKUP_PHYSICAL_SCHEDULE=weekly@sun,02:00
BACKUP_PHYSICAL_TIMEOUT=6h
BACKUP_PHYSICAL_S3_UPLOAD_ENABLED=false
BACKUP_XTRABACKUP_BIN=xtrabackup
BACKUP_XBCLOUD_BIN=xbcloud
BACKUP_XBCLOUD_PARALLEL=2
BACKUP_XBCLOUD_FIFO_STREAMS=1
BACKUP_XTRABACKUP_PARALLEL=4
BACKUP_XTRABACKUP_USER=xtrabackup
BACKUP_XTRABACKUP_PASS=change-me
BACKUP_XTRABACKUP_SOCKET=/var/run/mysqld/mysqld.sock
BACKUP_XTRABACKUP_RUN_AS_USER=mysql
# Optional; defaults to BACKUP_DIR/xtrabackup-work.
BACKUP_XTRABACKUP_WORK_DIR=

# Shared S3 settings.
BACKUP_S3_BUCKET=change-me
BACKUP_S3_REGION=change-me
BACKUP_S3_LOGICAL_PREFIX=logical
BACKUP_S3_PHYSICAL_PREFIX=physical
BACKUP_S3_KEY_ID=change-me
BACKUP_S3_KEY_SECRET=change-me

# Logical backup S3 upload settings.
BACKUP_S3_UPLOAD_MODE=direct
BACKUP_S3_UPLOAD_URL=
BACKUP_S3_UPLOAD_TIMEOUT=2h
BACKUP_S3_PHP_BIN=/usr/bin/php
BACKUP_S3_UPLOAD_SCRIPT=

# Built-in API server settings.
BACKUP_API_ENABLED=false
BACKUP_API_LISTEN_ADDR=127.0.0.1:8086
BACKUP_API_BASE_PATH=/api/v1
BACKUP_API_AUTH_ENABLED=false
BACKUP_API_BEARER_TOKEN=

# Optional runtime label written into run metadata.
BACKUP_EXECUTION_SOURCE=runner

# Prometheus label customisation.
# These control the label set applied to every metric in the .prom file.
# BACKUP_METRICS_JOB     - Prometheus job label (default: sdl_db_backup)
# BACKUP_METRICS_SERVICE - Prometheus service label (default: mysql)
# BACKUP_METRICS_ENV     - Prometheus env label (default: pilot)
# BACKUP_METRICS_REGION  - Prometheus region label (optional; omitted from metric if empty)
BACKUP_METRICS_JOB=sdl_db_backup
BACKUP_METRICS_SERVICE=mysql
BACKUP_METRICS_ENV=pilot
BACKUP_METRICS_REGION=

# --- RESTORE VALIDATION (SANDBOX TESTING) ---
# Set up a dedicated, isolated sandbox database to safely test restore operations.
# WARNING: NEVER point this to a live/production database. The validation process
# will drop and recreate tables during testing.
RESTORE_TEST_ENABLED=false
RESTORE_TEST_HOST=
RESTORE_TEST_PORT=3306
RESTORE_TEST_USER=root
RESTORE_TEST_PASS=

# Schedule formats:
#   always
#   disabled
#   daily@07:30
#   weekly@sun,07:30
#   interval@24h

# Optional S3-compatible endpoint for the built-in direct client (path-style buckets).
# Empty preserves the AWS regional endpoint. Does not configure xbcloud.
BACKUP_S3_ENDPOINT=

# Recovery safety: automatic deletion is held until explicitly authorized.
BACKUP_RETENTION_DELETE_ENABLED=false
BACKUP_RETENTION_MIN_COMPLETE=2
# Existing gzip/encryption streaming needs no second raw SQL file.
# auto selects installed system units; explicit system is recommended in production.
BACKUP_SYSTEMD_SCOPE=auto
BACKUP_SCHEDULE_TIMEZONE=Local
# global uses one MySQL InnoDB transaction plus LOCK INSTANCE FOR BACKUP.
# Requires existing BACKUP_ADMIN authorization; do not grant it automatically.
# Keep table scope empty and exclude schema deployments during capture.
# The production profile uses global; per_database preserves generic compatibility.
BACKUP_LOGICAL_CONSISTENCY=per_database
# Requires a compatible client with --init-command (production uses MySQL 8.4.11).
# Uses only SET SESSION; never SET GLOBAL. See PRODUCTION_CONFIGURATION.md.
BACKUP_MYSQLDUMP_SESSION_TIMEOUT_OVERRIDE=true

# Automatic LOCAL disk-pressure recovery; requires operator authorization.
# Separate from legacy GFS quarantine. Never deletes remote S3 objects.
# Needs two independently verified complete offsite points and protects the
# latest complete local snapshot (prefer two), restore-tested/pinned points,
# uniquely useful partial captures and physical/binlog dependencies.
BACKUP_STORAGE_AUTO_CLEANUP=false
# Maximum local payload runs; 0 disables count retention. Requires auto cleanup.
# At least 3 preserves two verified points plus one slot for a new capture.
BACKUP_LOCAL_MAX_BACKUPS=0
BACKUP_STORAGE_ESTIMATE_BYTES=0
BACKUP_STORAGE_RESERVE_BYTES=2147483648
BACKUP_STORAGE_HIGH_WATERMARK=92
BACKUP_STORAGE_LOW_WATERMARK=90
BACKUP_STORAGE_GROWTH_PERCENT=50
BACKUP_STORAGE_HISTORY_RUNS=12
BACKUP_STORAGE_CONCURRENT_BYTES=536870912
BACKUP_STORAGE_TEMPORARY_BYTES=268435456
BACKUP_STORAGE_MIN_FREE_INODES=128
BACKUP_STORAGE_TEMP_MAX_AGE=24h
BACKUP_STORAGE_VERIFY_TIMEOUT=20m
# Optional explicitly approved existing directory on a DIFFERENT filesystem.
# Leave empty when no secondary destination is approved.
BACKUP_STORAGE_SECONDARY_DIR=
