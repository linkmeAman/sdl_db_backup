{
  "openapi": "3.0.3",
  "info": {
    "title": "SDL DB Backup API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/backups/health": {
      "get": {
        "summary": "Get backup health and runtime status",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/backups/runs": {
      "get": {
        "summary": "List backup runs with derived final_outcome",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create a manual backup run and return derived final_outcome",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/backups/runs/{run_id}": {
      "get": {
        "summary": "Get one backup run with derived final_outcome",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Read base config",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Update base config",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/config/effective": {
      "get": {
        "summary": "Read effective config",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/schedules/temporary-overrides": {
      "get": {
        "summary": "Read temporary overrides",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Set temporary overrides",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "summary": "Clear temporary overrides",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/systemd": {
      "get": {
        "summary": "Read systemd status and rendered unit templates",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/systemd/actions/{action}": {
      "post": {
        "summary": "Run a user-level systemd action",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/logs/daily": {
      "get": {
        "summary": "Read daily log lines",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/logs/runs": {
      "get": {
        "summary": "Read run index lines",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/storage": {
      "get": {
        "summary": "Read storage settings summary",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/runtime": {
      "get": {
        "summary": "Read runtime profile",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/restore": {
      "get": {
        "summary": "Restore validation capability status",
        "responses": {
          "200": {
            "description": "Restore validation capability summary"
          }
        }
      }
    },
    "/api/v1/restore/validate": {
      "post": {
        "summary": "Validate a logical backup run without restoring it",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["run_id"],
                "properties": {
                  "run_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result"
          }
        }
      }
    },
    "/api/v1/restore/test": {
      "post": {
        "summary": "Run a full sandbox restore test for a logical backup run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["run_id"],
                "properties": {
                  "run_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sandbox restore validation result"
          }
        }
      }
    }
  }
}
